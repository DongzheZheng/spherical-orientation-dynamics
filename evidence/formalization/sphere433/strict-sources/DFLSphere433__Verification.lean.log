DFLFirstEigenspace.round_first_eigenfunction_iff_linear.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} [Fact (Module.finrank ℝ E = n + 1)] [NeZero n]
  (f :
    ContMDiffMap (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin n))) (modelWithCornersSelf ℝ ℝ) ↑(Metric.sphere 0 1) ℝ
      ↑⊤) :
  (∀ (x : ↑(Metric.sphere 0 1)),
      DifferentialGeometry.Geometry.Operator.ΔG DifferentialGeometry.Geometry.roundMetric f x = -↑n * f x) ↔
    ∃ a, ∀ (x : ↑(Metric.sphere 0 1)), f x = inner ℝ a ↑x
