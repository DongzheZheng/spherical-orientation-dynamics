  (hf : MeasureTheory.MemLp f 2 (DFLSphere.vMFVolume k r))
  (G : (x : ↑(DFLSphere.RoundSphere k)) → TangentSpace (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin (k + 2)))) x)
  (hG : DifferentialGeometry.Analysis.Sobolev.IntrinsicLp.HasWeakRiemannianGradLp (DFLSphere.roundSphereMetric k) f G)
  (hGn :
    MeasureTheory.MemLp (DFLWeakH1Completion.metricNorm (DFLSphere.roundSphereMetric k) G) 2 (DFLSphere.vMFVolume k r))
