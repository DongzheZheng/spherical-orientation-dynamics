          (↑↑((DifferentialGeometry.Analysis.Laplacian.H1ComplToLp (DFLSphere.roundSphereMetric k)) U)) G ∧
        MeasureTheory.MemLp (DFLWeakH1Completion.metricNorm (DFLSphere.roundSphereMetric k) G) 2
            (DFLSphere.roundVolume k) ∧
          DFLSphere.roundPotentialEnergy k V U = lam ∧
            (∀ (W : DifferentialGeometry.Analysis.Laplacian.H1Compl (DFLSphere.roundSphereMetric k)),
                lam * ‖(DifferentialGeometry.Analysis.Laplacian.H1ComplToLp (DFLSphere.roundSphereMetric k)) W‖ ^ 2 ≤
                  DFLSphere.roundPotentialEnergy k V W) ∧
              ∀ (φ : DifferentialGeometry.Analysis.Laplacian.SmoothScalar (DFLSphere.roundSphereMetric k)),
                ∫ (x : ↑(DFLSphere.RoundSphere k)),
                      (((DFLSphere.roundSphereMetric k).inner x) (G x))
                        (DifferentialGeometry.Geometry.Operator.gradFun (DFLSphere.roundSphereMetric k) φ.toFun
                          x) ∂DFLSphere.roundVolume k +
