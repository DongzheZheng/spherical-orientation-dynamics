DFL.Geometry.sphere_nondegenerateFold_three :
  ∃ rStar,
    0 < rStar ∧
      (∀ (r : ℝ), 0 < r → r < rStar → deriv (DFL.Geometry.sphereEquilibriumDensity 3 DFL.Geometry.three_pos✝) r < 0) ∧
        deriv (DFL.Geometry.sphereEquilibriumDensity 3 DFL.Geometry.three_pos✝¹) rStar = 0 ∧
          (∀ (r : ℝ), rStar < r → 0 < deriv (DFL.Geometry.sphereEquilibriumDensity 3 DFL.Geometry.three_pos✝²) r) ∧
            0 < deriv (deriv (DFL.Geometry.sphereEquilibriumDensity 3 DFL.Geometry.three_pos✝³)) rStar
'DFL.Geometry.sphere_nondegenerateFold_three' depends on axioms: [propext, Classical.choice, Quot.sound]
