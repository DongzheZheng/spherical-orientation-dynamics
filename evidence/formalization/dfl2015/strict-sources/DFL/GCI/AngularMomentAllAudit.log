DFL.GCI.weak_solution_moment_identity_three (r : ℝ) (s : DFL.GCI.AngularState)
  (hs : DFL.GCI.OriginalWeakGCISolution 3 r s) :
  DFL.GCI.originalForcingNorm 3 r = 2 * DFL.GCI.originalGCIDenominator 3 r s + r * DFL.GCI.originalGCINumerator 3 r s
DFL.GCI.weak_solution_moment_identity_all (n : ℕ) (hn : 2 ≤ n) (r : ℝ) (s : DFL.GCI.AngularState)
  (hs : DFL.GCI.OriginalWeakGCISolution n r s) :
  DFL.GCI.originalForcingNorm n r =
    (↑n - 1) * DFL.GCI.originalGCIDenominator n r s + r * DFL.GCI.originalGCINumerator n r s
DFL.GCI.original_GCI_shift_upper_all (n : ℕ) (hn : 2 ≤ n) (r : ℝ) (hr : 0 < r) (s : DFL.GCI.AngularState)
  (hs : DFL.GCI.OriginalWeakGCISolution n r s) : DFL.GCI.originalGCICoefficient n r s ≤ DFL.orientationMean (n + 2) r
DFL.GCI.original_GCI_strict_upper_all (n : ℕ) (hn : 2 ≤ n) (r : ℝ) (hr : 0 < r) (s : DFL.GCI.AngularState)
  (hs : DFL.GCI.OriginalWeakGCISolution n r s) : DFL.GCI.originalGCICoefficient n r s < DFL.orientationMean n r
