DFL.GCI.threeD_singular_derivative_integrable :
  IntervalIntegrable DFL.GCI.threeDSingularDerivative✝ MeasureTheory.volume 0 Real.pi
DFL.GCI.momentFlux_three_AC (r : ℝ) : AbsolutelyContinuousOnInterval (DFL.GCI.momentFlux 3 r) 0 Real.pi
DFL.GCI.threeD_remainder_integrable (r : ℝ) (s : DFL.GCI.AngularState) (hs : DFL.GCI.OriginalWeakGCISolution 3 r s) :
  IntervalIntegrable (fun θ => DFL.GCI.momentRemainderWeight 3 r θ * DFL.GCI.momentPrimitive s θ) MeasureTheory.volume 0
    Real.pi
DFL.GCI.threeD_ibp_term_integrable (r : ℝ) (s : DFL.GCI.AngularState) (hs : DFL.GCI.OriginalWeakGCISolution 3 r s) :
