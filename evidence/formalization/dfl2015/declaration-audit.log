DFL.DFL2015UnimodalityConjecture : Prop
def DFL.IsUnimodal : ℕ → Prop :=
fun n =>
  ∃ rStar,
    0 < rStar ∧
      StrictAntiOn (DFL.equilibriumDensity n) (Set.Ioc 0 rStar) ∧
        StrictMonoOn (DFL.equilibriumDensity n) (Set.Ici rStar) ∧
          deriv (DFL.equilibriumDensity n) rStar = 0 ∧
            ∀ (r : ℝ), 0 < r → deriv (DFL.equilibriumDensity n) r = 0 → r = rStar
def DFL.DFL2015UnimodalityConjecture : Prop :=
∀ (n : ℕ), 2 ≤ n → DFL.IsUnimodal n
